---
import Logo from '@/assets/logoP.svg'
import MainNav from './MainNav.astro'

interface Props {
  subtitle: string;
  bgImage: string;
}
const { subtitle, bgImage } = Astro.props


---
<header
    class="min-h-72 relative pb-72"
>
    <div class="absolute inset-0  bg-center bg-cover"
        style={`background-image: url(${bgImage})`}
    ></div>
    <div class="absolute inset-0 bg-black/40"></div>
    
    <div class="relative max-w-7xl mx-auto py-14 ">
        <div class="flex flex-col items-center lg:flex-row lg:justify-between">
            <a href="/">
                <Logo class="w-72" />
            </a>
            <MainNav />
        </div>

          <h1 class:list={[
            'text-4xl font-black text-center mt-12',
            Astro.url.pathname === '/contacto/' ? 'text-blue-500' : 'text-coffee-300 uppercase'
        ]}>{subtitle}</h1>
    </div>
</header>