---
import CoffeeMenu from "./CoffeeMenu.astro";
import FoodMenu from "./FoodMenu.astro";
---

<section class="bg-coffee-700 py-10 -mt-20">
    <div
        class="max-w-7xl mx-auto bg-menu-image bg-no-repeat bg-contain bg-position-[center_80px] pt-37.5 lg:pt-62.5 pb-40"
    >
        <h3
            class="mt-3 text-blue-500 font-black text-center text-xl pt-25 uppercase"
        >
            Todos nuestros productos se preparan al momento.
            <span class="text-4xl block pt-10">Menu</span>
        </h3>
        <h2 class="text-center space-y-5 coffee-icon"></h2>

        <div class="grid grid-cols-1 2xl:grid-cols-2 gap-5 mt-10">
            <CoffeeMenu />
            <FoodMenu />
        </div>
    </div>
</section>
