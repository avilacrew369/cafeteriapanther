---
import "@/styles/global.css";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";
interface Props {
	title: string;
	subtitle: string;
	bgImage: string;
}
const { title, subtitle, bgImage } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>Cafeteria Panther: {title}</title>
	</head>
	<body >
		<Header subtitle={subtitle} bgImage={bgImage} />
			<main class="bg-pink-500 p-20 max-w-7xl mx-auto px-5 lg:-mt-20 relative">
				<p>soy Panther</p>
				<slot />
			</main>
			<slot name="after-main-content"/>
		<Footer />
	</body>
</html>
